# Sem DJANGO_DEBUG=True o sistema roda em modo de produção e exige uma DJANGO_SECRET_KEY.
# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Somente em produção (DJANGO_DEBUG=False):
# origens confiáveis para o CSRF quando o site roda atrás de um domínio próprio,
# cookies apenas via HTTPS, redirecionamento para HTTPS, HSTS em segundos
# e o cabeçalho X-Forwarded-Proto de um proxy reverso que termina o HTTPS.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://grello.exemplo.com
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=False
# DJANGO_BEHIND_HTTPS_PROXY=False
#
# Bloqueio de login após tentativas sem sucesso (por usuário e IP).
# DJANGO_LOGIN_MAX_ATTEMPTS=5
# DJANGO_LOGIN_LOCKOUT_SECONDS=900

# DB_HOST e DB_PORT valem para rodar fora do Docker.
# No Docker Compose o serviço web sempre usa db:5432.
DB_NAME=gestao_tarefas
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres
DB_HOST=localhost
DB_PORT=5432

# Somente para o Docker Compose:
# porta do PostgreSQL publicada no host e carga dos dados de demonstração ao subir.
DB_HOST_PORT=5433
SEED_DEMO=0
