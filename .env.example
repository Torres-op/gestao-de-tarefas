DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DB_HOST e DB_PORT valem para rodar fora do Docker.
# No Docker Compose o serviço web sempre usa db:5432.
DB_NAME=gestao_tarefas
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres
DB_HOST=localhost
DB_PORT=5432

# Somente para o Docker Compose:
# porta do PostgreSQL publicada no host e carga dos dados de demonstração ao subir.
DB_HOST_PORT=5433
SEED_DEMO=0
