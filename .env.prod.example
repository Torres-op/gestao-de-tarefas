# Modelo de variáveis para o compose.prod.yml. Copie para .env.prod (fora do Git) e ajuste.
# Gere a chave com:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DB_PASSWORD=troque-por-uma-senha-forte

# Domínio público do sistema. Mantenha localhost para o health check interno do container.
DJANGO_ALLOWED_HOSTS=grello.exemplo.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://grello.exemplo.com

# Atrás de um proxy reverso que termina o HTTPS (Nginx, Caddy, Traefik ou balanceador):
DJANGO_BEHIND_HTTPS_PROXY=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Para experimentar localmente sem HTTPS (http://localhost:8000), use:
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SECURE_COOKIES=False
# DJANGO_SECURE_HSTS_SECONDS=0

WEB_HOST_PORT=8000
WEB_CONCURRENCY=3
